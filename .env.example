NODE_ENV=development
PORT=3000

# Supabase — Project Settings > Database > Connection String
# Pooled (transaction mode, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.wcymqxoprbkssqabdmvn:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (session mode, port 5432) — used only by `prisma migrate`
DIRECT_URL="postgresql://postgres.wcymqxoprbkssqabdmvn:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Cloudinary — get these from cloudinary.com > Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

API_PREFIX=api/v1
